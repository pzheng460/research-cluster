# Set a long random value before exposing the API beyond loopback.
CLUSTER_TOKEN=
CLUSTER_PORT=8787
POSTGRES_PASSWORD=research-local-development

# Model-backed research is optional. The CPU benchmark needs no model credentials.
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# CLI defaults: SQLite + local research orchestrator.
# CLUSTER_DATA_DIR=.state
# CLUSTER_DATABASE_URL=postgresql+psycopg://research:password@localhost:5432/research
# CLUSTER_ORCHESTRATOR=temporal
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# CLUSTER_REPO_ROOT=/absolute/path/to/allowed/repositories
# Per orchestrator process, independent of CPU/GPU worker slots (1..32).
# CLUSTER_MAX_CONCURRENT_RESEARCH=4

# Lean lives on the verification worker, not necessarily on the API host.
# Default: CLUSTER_DATA_DIR/toolchains/lean-4.35.0-linux
# CLUSTER_LEAN_HOME=/absolute/path/to/lean-4.35.0-linux
